# Copy to .streamlit/secrets.toml locally, or paste into the host's "Secrets" settings.
GEMINI_API_KEY = "your-gemini-key"
GEMINI_MODELS = "gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite"
APP_PASSWORD = "choose-a-password"          # stops strangers from using up your API quota
